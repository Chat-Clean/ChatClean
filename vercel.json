{
  "headers": [
    {
      "source": "/([aA][dD][mM][iI][nN])",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/([aA][dD][mM][iI][nN])/:caminho*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/assinar",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/assinatura/recebido",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ],
  "rewrites": [
    { "source": "/blog", "destination": "/api/blog" },
    { "source": "/blog/:slug", "destination": "/api/blog?slug=:slug" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/llms.txt", "destination": "/api/llms" },
    { "source": "/feed.xml", "destination": "/api/feed" },
    { "source": "/mcp", "destination": "/api/posts?via=mcp" },
    { "source": "/mcp/registrar", "destination": "/api/posts?via=mcp-registrar" },
    { "source": "/mcp/autorizar", "destination": "/api/posts?via=mcp-autorizar" },
    { "source": "/mcp/token", "destination": "/api/posts?via=mcp-token" },
    { "source": "/.well-known/oauth-protected-resource", "destination": "/api/posts?via=mcp-recurso" },
    { "source": "/.well-known/oauth-protected-resource/mcp", "destination": "/api/posts?via=mcp-recurso" },
    { "source": "/.well-known/oauth-authorization-server", "destination": "/api/posts?via=mcp-servidor" },
    { "source": "/.well-known/oauth-authorization-server/mcp", "destination": "/api/posts?via=mcp-servidor" },
    { "source": "/carreiras", "destination": "/api/carreiras" },
    { "source": "/carreiras/:slug", "destination": "/api/carreiras?slug=:slug" },
    { "source": "/api-oficial-whatsapp", "destination": "/paginas/api-oficial-whatsapp.html" },
    { "source": "/integracoes", "destination": "/paginas/integracoes.html" },
    { "source": "/sobre", "destination": "/paginas/sobre.html" },
    { "source": "/noticias", "destination": "/paginas/noticias.html" },
    { "source": "/politica-de-privacidade", "destination": "/paginas/politica-de-privacidade.html" },
    { "source": "/termos-de-servico", "destination": "/paginas/termos-de-servico.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
